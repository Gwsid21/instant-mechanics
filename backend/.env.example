# Docker: mongodb://127.0.0.1:27017/instant_mechanic  (run: docker run -p 27017:27017 -d mongo)
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/instant_mechanic
MONGO_URI=mongodb+srv://gwsid21:Sidd(2006)@cluster0.sefh1wc.mongodb.net/instant_mechanic?appName=Cluster0
# Port the API server listens on
PORT=4000

# Origin allowed to call the API / connect via WebSocket (your frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# Set to "false" to disable the built-in live-data simulator
# (only useful if you're driving status changes yourself, e.g. in a demo)
ENABLE_SIMULATOR=true
